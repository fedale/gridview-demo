{
    "controllers": {
        "@symfony/ux-turbo": {
            "turbo-core": {
                "enabled": true,
                "fetch": "eager"
            },
            "mercure-turbo-stream": {
                "enabled": false,
                "fetch": "eager"
            }
        },
        "@fedale/gridview-bundle": {
            "crud": {
                "enabled": true,
                "fetch": "lazy"
            },
            "dropdown": {
                "enabled": true,
                "fetch": "lazy"
            },
            "export": {
                "enabled": true,
                "fetch": "lazy"
            },
            "visibility": {
                "enabled": true,
                "fetch": "lazy"
            },
            "saved-search": {
                "enabled": true,
                "fetch": "lazy"
            },
            "selection": {
                "enabled": true,
                "fetch": "lazy"
            },
            "infinite-scroll": {
                "enabled": true,
                "fetch": "lazy"
            },
            "inline-edit": {
                "enabled": true,
                "fetch": "lazy"
            },
            "column-order": {
                "enabled": true,
                "fetch": "lazy"
            },
            "responsive": {
                "enabled": true,
                "fetch": "lazy"
            },
            "grouping": {
                "enabled": true,
                "fetch": "lazy"
            },
            "filter": {
                "enabled": true,
                "fetch": "lazy"
            },
            "date-filter": {
                "enabled": false,
                "fetch": "lazy"
            },
            "relation-filter": {
                "enabled": true,
                "fetch": "lazy"
            },
            "form-validate": {
                "enabled": true,
                "fetch": "lazy"
            },
            "page-jump": {
                "enabled": true,
                "fetch": "lazy"
            },
            "i18n": {
                "enabled": true,
                "fetch": "lazy"
            },
            "locale-switcher": {
                "enabled": true,
                "fetch": "lazy"
            },
            "mercure": {
                "enabled": true,
                "fetch": "lazy"
            }
        }
    },
    "entrypoints": []
}
